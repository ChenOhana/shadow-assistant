# systemd *user* service: runs `brain run` as you, inside your desktop
# session (it needs your session D-Bus for focus tracking, the clipboard,
# screen lock and keyboard layouts: KWin and Klipper on KDE Plasma, brain's
# GNOME Shell extension on GNOME). No root: keyboards are read through the
# `input` group. Install with `make install-service`; `make uninstall-service`
# removes it together with its data (KEEP_DATA=1 keeps the data).
[Unit]
Description=brain: capture what you type and make it searchable
Documentation=https://github.com/ChenOhana/shadow-assistant
# Start with the desktop session, after the compositor (KWin or GNOME
# Shell; a unit that does not exist is ignored), and stop at logout.
PartOf=graphical-session.target
After=graphical-session.target plasma-kwin_wayland.service org.gnome.Shell@wayland.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
# The data directory is the service's state directory, created by systemd
# before start, private to the user: ~/.local/state/brain (%S/brain).
# `systemctl --user clean --what=state brain` deletes it.
StateDirectory=brain
StateDirectoryMode=0700
ExecStart=/usr/bin/brain run --data-dir %S/brain
# SIGTERM stops brain cleanly (final ingest, KWin script unloaded on KDE).
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# stderr (warnings, layout switches, tier 2 failures) goes to the journal:
#   journalctl --user -u brain -f

[Install]
WantedBy=graphical-session.target
